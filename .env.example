# Application
JARVIS_NAME=Jarvis

# Startup
STARTUP_GREETING_ENABLED=true
STARTUP_GREETING_DELAY=5
STARTUP_GREETING=Good morning, Sir.

# Wake Word
WAKE_WORD_ENABLED=true
WAKE_WORD=jarvis
# Backend: "openwakeword" (default, local, no API key), "energy"
# (free fallback, less accurate), or "porcupine" (legacy, needs
# PORCUPINE_ACCESS_KEY below).
WAKEWORD_BACKEND=openwakeword
# openWakeWord pretrained model name (e.g. "hey_jarvis", "alexa",
# "hey_mycroft", "hey_rhasspy", "timer", "weather") or path to a
# custom .tflite / .onnx model file.
OPENWAKEWORD_MODEL=hey_jarvis
# Detection threshold (0.0 - 1.0). Higher = fewer false positives,
# lower = more sensitive. Default 0.5 is a reasonable starting point.
OPENWAKEWORD_THRESHOLD=0.5

# Optional legacy Porcupine settings (only used if WAKEWORD_BACKEND=porcupine).
# The default path does NOT require Picovoice signup. Leave these empty
# unless you specifically want Porcupine.
PORCUPINE_ACCESS_KEY=
PORCUPINE_KEYWORD_PATH=
PORCUPINE_SENSITIVITY=0.5

# Listening
LISTEN_TIMEOUT=10
SILENCE_TIMEOUT=1.5

# AI: openai | gemini | mock
AI_PROVIDER=mock
AI_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=

# TTS
TTS_PROVIDER=edge
TTS_VOICE=en-US-GuyNeural

# Hotkey
HOTKEY_EXIT=Ctrl+Shift+J

# Logging
LOG_LEVEL=INFO
